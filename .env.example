# infra/deploy.sh writes a ready-made .env for you, so you normally do not
# need this file. Use it only if you create the Azure resources yourself. Auth throughout is Microsoft Entra ID
# (DefaultAzureCredential) — run `az login` before starting a notebook.
# Nothing here needs a Search admin key or a storage account key.

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=state-driver-manuals

# --- Azure Storage (Blob) ---
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER_NAME=docs

# --- Azure OpenAI (embeddings for M2 C2, chat models for M3) ---
AZURE_OPENAI_ENDPOINT=https://<your-aiservices-resource>.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# gpt-4o-mini can no longer be freshly deployed (deprecated for new
# deployments as of 2026-03-31) — gpt-5-mini is today's equivalent
# small/cheap chat model, used for M3 C2's hand-rolled pipeline and C3's
# evaluators. Re-check this against your account's actual model catalog
# (`az cognitiveservices account list-models`) before you run the notebooks — this is
# exactly the kind of thing that drifts.
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
# M3 C1's managed "on your data" call needs a second, separate deployment:
# that Azure OpenAI extension still injects the legacy `max_tokens` param,
# which gpt-5-mini rejects. gpt-4.1-mini (a Legacy but still-deployable
# model) is compatible with it.
AZURE_OPENAI_ONYOURDATA_DEPLOYMENT=gpt-4.1-mini

# --- Microsoft Foundry project (M3 C1's managed connection, M3 C3's portal push) ---
# Created via `az cognitiveservices account project create` directly on the
# AI Services resource above — no separate ML-workspace hub needed for this
# SDK version (azure-ai-projects 2.x). Format:
# https://<aiservices-account-name>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_PROJECT_ENDPOINT=https://<your-aiservices-resource>.services.ai.azure.com/api/projects/<project-name>

# --- Azure AI Services multi-service (OCR skill attachment, M2 C1) ---
# Free-tier cognitive services attachments cap OCR at 20 docs/day, which you
# will blow through while practicing. Use a paid (S0) multi-service resource.
AZURE_AI_SERVICES_ENDPOINT=https://<your-aiservices-resource>.cognitiveservices.azure.com
AZURE_AI_SERVICES_KEY=<key — the skillset's cognitive services attachment is key-based>

# --- Only needed if you re-run infra/deploy.sh yourself ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rag-course-rg
AZURE_LOCATION=eastus
